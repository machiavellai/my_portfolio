# Copy to .env.local and fill in. Set the same values in Vercel → Project → Settings →
# Environment Variables. Used by the site (server-side, at build), the Sanity CLI and
# the hosted Studio. Never put a token in a SANITY_STUDIO_* variable: the Studio
# build writes these values into its JavaScript.
SANITY_STUDIO_PROJECT_ID=
SANITY_STUDIO_DATASET=production
